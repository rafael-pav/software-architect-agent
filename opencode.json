{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "software-architect",
  "experimental": {
    "subagent_depth": 1
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "docs/00-project-management/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "docs/01-planning/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "docs/02-requirements/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "docs/03-architecture/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "docs/04-research/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "docs/05-validation/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "framework/standards/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "framework/templates/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "framework/workflows/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    }
  ]
}