{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "software-architect",
  "experimental": {
    "subagent_depth": 1
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "docs/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    }
  ]
}